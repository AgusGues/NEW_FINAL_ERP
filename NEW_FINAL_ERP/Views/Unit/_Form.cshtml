@model Unit

<div class="modal fade" id="unitModal">
	<div class="modal-dialog">
		<div class="modal-content">

			<form id="unitForm">

				<div class="modal-header">
					<h5>@(Model.UnitId == 0 ? "Tambah Unit" : "Edit Unit")</h5>
				</div>

				<div class="modal-body">

					<input asp-for="UnitId" hidden />

					<input asp-for="UnitCode" class="form-control" hidden />


					<div class="mb-3">
						<label>Unit Name</label>
						<input asp-for="UnitName" class="form-control" />
						<span asp-validation-for="UnitName" class="text-danger"></span>
					</div>

					<div class="mb-3">
						<label>Description</label>
						<input asp-for="Description" class="form-control" />
						<span asp-validation-for="Description" class="text-danger"></span>
					</div>

				</div>

				<div class="modal-footer">
					<button type="button" class="btn btn-secondary"
							data-bs-dismiss="modal">
						Close
					</button>

					<button type="button" class="btn btn-primary"
							onclick="saveData()">
						Save
					</button>
				</div>

			</form>

		</div>
	</div>
</div>

<script>

	function saveData(){

	var data=$("#unitForm").serialize();

	$.post('/Unit/Save',data)
	.done(()=>{
	$('#unitModal').modal('hide');
	location.reload();
	})
	.fail(e=>{
	alert("Error: "+e.responseText);
	});

	}

</script>
