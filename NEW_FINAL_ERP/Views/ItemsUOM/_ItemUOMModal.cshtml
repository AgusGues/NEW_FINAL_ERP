@model NEW_FINAL_ERP.DTo.ItemUOMModalDto

<div class="modal fade" id="itemUomModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    @(Model.ItemUOMId == 0 ? "Create Item UOM" : "Edit Item UOM")
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form id="itemUomForm">
                <div class="modal-body">
                    <input type="hidden" name="ItemUOMId" value="@Model.ItemUOMId" />
                    <input type="hidden" name="UnitId" id="UnitId" value="@Model.UnitId" />
                    <input type="hidden" name="ItemId" id="ItemId" value="@Model.ItemId" />

                    <div class="row">
                        <!-- Item -->
                        <div class="col-md-6 mb-3">
                            <label>Item</label>
                            <select id="itemSearch" class="form-control"></select>
                        </div>

                        <!-- Unit -->
                        <div class="col-md-6 mb-3">
                            <label>Unit</label>
                            <select id="unitSearch" class="form-control"></select>
                        </div>

                        <!-- Conversion To Base -->
                        <div class="col-md-6 mb-3">
                            <label>Conversion To Base</label>
                            <input type="number"
                                   step="0.01"
                                   name="ConversionToBase"
                                   value="@Model.ConversionToBase.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                   class="form-control" />
                        </div>

                        <!-- Checkbox Group -->
                        <div class="col-md-6 mb-3">
                            <div class="d-flex flex-wrap gap-3 mt-2">
                                <div class="form-check">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           name="IsBase"
                                           value="true"
                                           @(Model.IsBase ? "checked" : "") />
                                    <label class="form-check-label">Base Unit</label>
                                </div>

                                <div class="form-check">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           name="IsDefaultSales"
                                           value="true"
                                           @(Model.IsDefaultSales ? "checked" : "") />
                                    <label class="form-check-label">Default Sales</label>
                                </div>

                                <div class="form-check">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           name="IsDefaultPurchase"
                                           value="true"
                                           @(Model.IsDefaultPurchase ? "checked" : "") />
                                    <label class="form-check-label">Default Purchase</label>
                                </div>
                            </div>
                        </div>

                        <!-- Barcode hanya tampil saat Edit -->
                        @if (Model.ItemUOMId > 0)
                        {
                            <div class="col-md-6 mb-3">
                                <label>Barcode</label>
                                <input name="Barcode"
                                       value="@Model.Barcode"
                                       class="form-control" />
                            </div>
                        }
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" onclick="saveData()">Save</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </form>

        </div>
    </div>
</div>

<script>
    // =======================
    // Select2 Item & Unit
    // =======================
    $('#itemUomModal').on('shown.bs.modal', function () {
        $('#itemSearch').select2({
            placeholder: 'Cari Item',
            width: '100%',
            dropdownParent: $('#itemUomModal'),
            minimumInputLength: 1,
            ajax: {
                url: '/ItemsUOM/SearchItem',
                dataType: 'json',
                delay: 250,
                data: function (params) { return { term: params.term }; },
                processResults: function (data) { return { results: data }; }
            }
        });
    });

    $('#itemSearch').on('select2:select', function (e) {
        $('#ItemId').val(e.params.data.id);
    });

    $('#unitSearch').select2({
        placeholder: 'Cari Satuan Konversi',
        width: '100%',
        dropdownParent: $('#itemUomModal'),
        minimumInputLength: 1,
        ajax: {
            url: '/ItemsUOM/SearchUnit',
            dataType: 'json',
            delay: 250,
            data: function (params) { return { term: params.term }; },
            processResults: function (data) { return { results: data }; }
        }
    });

    $('#unitSearch').on('select2:select', function (e) {
        $('#UnitId').val(e.params.data.id);
    });

    // =======================
    // Save via AJAX
    // =======================
    function saveData() {
        $.ajax({
            url: '/ItemsUOM/Modal',
            type: 'POST',
            data: $('#itemUomForm').serialize(),
            success: function (response) {
                if (response.success) {
                    $('#itemUomModal').modal('hide');
                    location.reload();
                } else if (response.errors) {
                    alert("Validation Errors:\n" + response.errors.join("\n"));
                } else if (response.message) {
                    alert("Error: " + response.message);
                }
            },
            error: function (xhr) {
                alert("Server error: " + xhr.responseText);
            }
        });
    }
</script>